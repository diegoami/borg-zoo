+    expect(sorted(actual)).toEqual(sorted(fixture.inventory));
+    expect(rng.getState().state).toEqual(fixture.after_outfit.state);
+    expect(rng.getState().stateI).toBe(fixture.after_outfit.stateI);
+  });
+});
